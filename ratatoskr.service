# systemd user unit: symlink into ~/.config/systemd/user/ (install.sh does it)
[Unit]
Description=Ratatoskr - Discord bridge to herdr agents
After=network-online.target

[Service]
ExecStart=%h/Work/ratatoskr/.venv/bin/python %h/Work/ratatoskr/ratatoskr.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
